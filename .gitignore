.env
.env.local
.env.production
.env.*.local
*.key
*.pem
*.crt

# =====================================================
# Backend (Go)
# =====================================================
backend/noab-server
backend/noab.db
backend/noab.db-shm
backend/noab.db-wal
backend/noab.db-journal
backend/uploads/
backend/data/
backend/certs/
backend/certs_bak/
backend/cmd/
backend/coverage.out
backend/*.test

# =====================================================
# Frontend (Node)
# =====================================================
deputy-portal/node_modules/
deputy-portal/dist/
deputy-portal/build/
deputy-portal/.vite/
deputy-portal/coverage/
deputy-portal/npm-debug.log*
deputy-portal/yarn-debug.log*
deputy-portal/yarn-error.log*
deputy-portal/.eslintcache

# =====================================================
# Docker
# =====================================================
docker-compose.override.yml

# =====================================================
# Test artifacts
# =====================================================
.playwright-mcp/
*.png
DeputyPortal_v2*.jsx
test-results/
playwright-report/

# =====================================================
# OS
# =====================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# =====================================================
# IDE
# =====================================================
.vscode/
.idea/
*.iml
.vimrc.local

# =====================================================
