# =====================================================
# Parliament Research Portal - Environment Variables
# =====================================================
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env
#
# ⚠️ لا ترفع .env إلى git أبداً (محمي في .gitignore)
# =====================================================

# -----------------------------------------------------
# 🔐 JWT Secret (مطلوب)
# -----------------------------------------------------
# مفتاح عشوائي لتوقيع الـ tokens
# يجب أن يكون 32 حرف على الأقل
#
# توليد سريع عبر:
#   openssl rand -hex 32
#   أو:
#   head -c 32 /dev/urandom | base64
# -----------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_random_32_chars_string_at_minimum_please

# -----------------------------------------------------
# 🌐 الدومين المسموح به في CORS
# -----------------------------------------------------
# للـ local development: اتركها فارغة (تعمل مع localhost تلقائياً)
# للإنتاج: حدد الدومين الكامل (مثال: https://perl.algonest.tech)
# -----------------------------------------------------
ALLOWED_ORIGIN=https://perl.algonest.tech

# -----------------------------------------------------
# 🛠️ بيئة التشغيل
# -----------------------------------------------------
# production = يجبر التحقق من JWT_SECRET ويفعل HSTS
# development = ألطف للاختبار المحلي
# -----------------------------------------------------
GO_ENV=production

# -----------------------------------------------------
# 🌱 Seed Data
# -----------------------------------------------------
# false = إدخال البيانات التجريبية في أول تشغيل (idempotent)
# true  = تعطيل seed (مفيد بعد أول تشغيل في الإنتاج)
# -----------------------------------------------------
NO_SEED=false

# -----------------------------------------------------
# 🚪 Frontend Port (للـ local فقط - Coolify يتجاهلها)
# -----------------------------------------------------
FRONTEND_PORT=3000
