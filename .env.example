# =====================================================
# Parliament Research Portal - Environment Variables
# =====================================================
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env
#
# ⚠️ لا ترفع .env إلى git أبداً (محمي في .gitignore)
# =====================================================

# -----------------------------------------------------
# 🔐 JWT Secret (مطلوب)
# -----------------------------------------------------
# مفتاح عشوائي لتوقيع الـ tokens
# يجب أن يكون 32 حرف على الأقل
#
# توليد سريع عبر:
#   openssl rand -hex 32
#   أو:
#   head -c 32 /dev/urandom | base64
# -----------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_random_32_chars_string_at_minimum_please

# -----------------------------------------------------
# 🌐 الدومين المسموح به في CORS
# -----------------------------------------------------
# للـ local development: اتركها فارغة (تعمل مع localhost تلقائياً)
# للإنتاج: حدد الدومين الكامل (الحالي: https://ppp.algonest.tech)
# -----------------------------------------------------
ALLOWED_ORIGIN=https://ppp.algonest.tech

# -----------------------------------------------------
# 🛠️ بيئة التشغيل
# -----------------------------------------------------
# production = يجبر التحقق من JWT_SECRET ويفعل HSTS
# development = ألطف للاختبار المحلي
# -----------------------------------------------------
GO_ENV=production

# -----------------------------------------------------
# 🌱 Seed Data
# -----------------------------------------------------
# false = إدخال البيانات التجريبية في أول تشغيل (idempotent)
# true  = تعطيل seed (مفيد بعد أول تشغيل في الإنتاج)
# -----------------------------------------------------
NO_SEED=false

# -----------------------------------------------------
# 🚪 Frontend Port (للـ local فقط - Coolify يتجاهلها)
# -----------------------------------------------------
FRONTEND_PORT=3000

# -----------------------------------------------------
# 📱 إشعارات SMS (اختياري)
# -----------------------------------------------------
# فارغة ⇒ يُسجَّل الإشعار في السجل فقط ولا يُرسل.
# جسم الطلب: {"to": "+964...", "message": "...", "sender": "..."}
# عدّل buildSMSPayload في handlers/sms.go إن اختلف عقد المزوّد.
# -----------------------------------------------------
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=

# -----------------------------------------------------
# 🔑 إعادة تعيين كلمة مرور الأدمن (مؤقت)
# -----------------------------------------------------
# ⚠️ يُعيد تعيين كلمة مرور admin@parliament.iq عند كل إقلاع.
# احذفه فور تسجيل الدخول وتغيير كلمة المرور، وإلا أُلغي أي تغيير.
# الحد الأدنى 10 أحرف.
# -----------------------------------------------------
ADMIN_PWD_RESET=

# -----------------------------------------------------
# 🧪 حسابات الفحص على صفحة الدخول
# -----------------------------------------------------
# افتراضياً ظاهرة (مرحلة التطوير والعرض): دخول بضغطة واحدة لأي دور.
# ⚠️ تكشف بيانات كل الأدوار بما فيها الأدمن لأي زائر.
# عند التشغيل الرسمي: اضبطها false في Coolify وأعد النشر.
# (متغير بناء — يُقرأ وقت البناء لا وقت التشغيل)
# -----------------------------------------------------
VITE_SHOW_DEMO_ACCOUNTS=true
